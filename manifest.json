{
  "manifest_version": 3,
  "name": "YouTube Dual Subtitles + Flashcards",
  "version": "1.4.0",
  "description": "English + Korean subtitles on YouTube, plus a Korean mini lesson on every new tab. Save words to flashcards you review with spaced repetition.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["https://www.youtube.com/*", "https://translate.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Dual Subtitles",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["cards.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "111"
}
